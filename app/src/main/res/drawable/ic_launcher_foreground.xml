    <!--
        Bold "K" lettermark centred in the 108×108 adaptive icon canvas.
        Safe zone is the inner 72×72 (18dp margin each side).
        Stem: x 28-44, full height 22-86
        Upper arm: stem junction at (44,50) → tip (86,22), width ~14dp
        Lower arm: stem junction at (44,58) → tip (86,86), width ~14dp
        Arms meet at the visual centre (54, 54).
    -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="
            M 28,22
            L 44,22
            L 44,50
            L 70,22
            L 86,22
            L 56,54
            L 86,86
            L 70,86
            L 44,58
            L 44,86
            L 28,86
            Z" />
</vector>
